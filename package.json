{
	"name": "@ryangarber/utils",
	"version": "0.1.1",
	"description": "Common utilities for my repositories.",
	"type": "module",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"lint": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"build": "tsdown"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/node": "^26.6.6",
		"@vitest/ui": "5.1.0",
		"chalk": "^6.0.1",
		"knip": "^6.44.1",
		"tsdown": "^0.23.5",
		"typescript": "7.1.0-beta",
		"vitest": "^5.1.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24 && <27",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
	"dependencies": {
		"listr2": "^11.4.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ryangarber/utils.git"
	}
}
